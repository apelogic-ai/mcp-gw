{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp.example.com/charts/mcp-gateway/values.schema.json",
  "title": "mcp-gateway Helm values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imagePullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": { "name": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "hop1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuers": {
          "type": "array",
          "items": { "$ref": "#/$defs/issuer" }
        }
      }
    },
    "agentgateway": { "$ref": "#/$defs/agentgateway" },
    "googleWorkspace": { "$ref": "#/$defs/googleWorkspace" },
    "dbMcp": { "$ref": "#/$defs/backend" },
    "githubWrapper": { "$ref": "#/$defs/backend" },
    "githubMcp": { "$ref": "#/$defs/backend" }
  },
  "$defs": {
    "image": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "digest": { "type": "string", "pattern": "^(|sha256:[a-fA-F0-9]{64})$" }
          }
        }
      ]
    },
    "secretKeyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "issuer", "audiences", "jwksUrl"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "issuer": { "type": "string", "format": "uri" },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "jwksUrl": { "type": "string", "format": "uri" },
        "discoverable": { "type": "boolean" },
        "clientId": { "type": "string" },
        "emailClaim": { "type": "string", "minLength": 1 },
        "subjectClaim": { "type": "string", "minLength": 1 },
        "introspection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "credentialSecretKeyRef"],
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "credentialSecretKeyRef": { "$ref": "#/$defs/secretKeyRef" }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "probe": {
      "type": "object",
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } },
      "additionalProperties": true
    },
    "hpa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "string" }] }
      }
    },
    "workloadProperties": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/$defs/image" },
        "replicas": { "type": "integer", "minimum": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "serviceAccount": { "$ref": "#/$defs/serviceAccount" },
        "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "resources": { "type": "object" },
        "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "affinity": { "type": "object" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "liveness": { "$ref": "#/$defs/probe" },
            "readiness": { "$ref": "#/$defs/probe" }
          }
        },
        "hpa": { "$ref": "#/$defs/hpa" },
        "pdb": { "$ref": "#/$defs/pdb" }
      }
    },
    "backend": {
      "allOf": [
        { "$ref": "#/$defs/workloadProperties" },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "env": {
              "type": "object",
              "additionalProperties": { "type": ["string", "number", "boolean"] }
            },
            "secretRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "name": { "type": "string" } }
            }
          }
        }
      ]
    },
    "googleWorkspace": {
      "allOf": [
        { "$ref": "#/$defs/backend" },
        {
          "type": "object",
          "properties": {
            "policy": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "mountPath": { "type": "string" },
                "yaml": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "agentgateway": {
      "allOf": [
        { "$ref": "#/$defs/workloadProperties" },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "service": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] } }
            },
            "backends": { "type": "array", "items": { "type": "object" } },
            "mcpAuthentication": { "type": "object" },
            "ingress": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "paths": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "pattern": "^/" }
                }
              }
            }
          }
        }
      ]
    }
  }
}
