{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp.example.com/charts/mcp-gateway/values.schema.json",
  "title": "mcp-gateway Helm values",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["googleWorkspace"],
        "properties": {
          "googleWorkspace": {
            "required": ["authorizationBroker"],
            "properties": {
              "authorizationBroker": {
                "required": ["enabled"],
                "properties": { "enabled": { "const": true } }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "agentgateway": {
            "properties": {
              "enabled": { "const": true },
              "ingress": { "properties": { "enabled": { "const": true } } }
            }
          },
          "googleWorkspace": { "properties": { "enabled": { "const": true } } }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": ["agentgateway"],
            "properties": {
              "agentgateway": {
                "required": ["enabled"],
                "properties": { "enabled": { "const": true } }
              }
            }
          },
          {
            "required": ["googleWorkspace"],
            "properties": {
              "googleWorkspace": {
                "required": ["enabled"],
                "properties": { "enabled": { "const": true } }
              }
            }
          },
          {
            "required": ["githubWrapper"],
            "properties": {
              "githubWrapper": {
                "required": ["enabled"],
                "properties": { "enabled": { "const": true } }
              }
            }
          }
        ]
      },
      "then": {
        "required": ["hop1"],
        "properties": {
          "hop1": {
            "required": ["issuers"],
            "properties": { "issuers": { "minItems": 1 } }
          }
        }
      }
    },
    {
      "if": {
        "required": ["oauthMigrations"],
        "properties": {
          "oauthMigrations": {
            "required": ["enabled"],
            "properties": { "enabled": { "const": true } }
          }
        }
      },
      "then": {
        "properties": {
          "oauthMigrations": {
            "required": ["secretKeyRef"],
            "properties": {
              "secretKeyRef": { "$ref": "#/$defs/secretKeyRef" }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "productionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imagePullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": { "name": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "hop1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuers": {
          "type": "array",
          "items": { "$ref": "#/$defs/issuer" }
        }
      }
    },
    "postgresql": { "$ref": "#/$defs/postgresql" },
    "oauthMigrations": { "$ref": "#/$defs/oauthMigrations" },
    "agentgateway": { "$ref": "#/$defs/agentgateway" },
    "googleWorkspace": { "$ref": "#/$defs/googleWorkspace" },
    "dbMcp": { "$ref": "#/$defs/backend" },
    "githubWrapper": { "$ref": "#/$defs/backend" },
    "githubMcp": { "$ref": "#/$defs/backend" }
  },
  "$defs": {
    "image": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "digest": { "type": "string", "pattern": "^(|sha256:[a-fA-F0-9]{64})$" }
          }
        }
      ]
    },
    "secretKeyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caBundle"],
      "properties": {
        "caBundle": { "$ref": "#/$defs/caBundle" }
      }
    },
    "caBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "mountPath", "configMapKeyRef", "secretKeyRef"],
      "allOf": [
        {
          "if": {
            "required": ["enabled"],
            "properties": { "enabled": { "const": true } }
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "configMapKeyRef": { "$ref": "#/$defs/secretKeyRef" },
                  "secretKeyRef": { "$ref": "#/$defs/emptyKeyRef" }
                }
              },
              {
                "properties": {
                  "configMapKeyRef": { "$ref": "#/$defs/emptyKeyRef" },
                  "secretKeyRef": { "$ref": "#/$defs/secretKeyRef" }
                }
              }
            ]
          },
          "else": {
            "properties": {
              "configMapKeyRef": { "$ref": "#/$defs/emptyKeyRef" },
              "secretKeyRef": { "$ref": "#/$defs/emptyKeyRef" }
            }
          }
        }
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "mountPath": { "type": "string", "pattern": "^/.*[^/]$" },
        "configMapKeyRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {
            "name": { "type": "string" },
            "key": { "type": "string" }
          }
        },
        "secretKeyRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {
            "name": { "type": "string" },
            "key": { "type": "string" }
          }
        }
      }
    },
    "emptyKeyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key"],
      "properties": {
        "name": { "type": "string", "maxLength": 0 },
        "key": { "type": "string", "maxLength": 0 }
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "issuer", "audiences", "jwksUrl", "allowedAlgorithms"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "issuer": { "type": "string", "format": "uri" },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "jwksUrl": { "type": "string", "format": "uri" },
        "allowedAlgorithms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "RS256",
              "RS384",
              "RS512",
              "PS256",
              "PS384",
              "PS512",
              "ES256",
              "ES384",
              "EdDSA"
            ]
          }
        },
        "discoverable": { "type": "boolean" },
        "clientId": { "type": "string" },
        "emailClaim": { "type": "string", "minLength": 1 },
        "subjectClaim": { "type": "string", "minLength": 1 },
        "introspection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "credentialSecretKeyRef"],
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "credentialSecretKeyRef": { "$ref": "#/$defs/secretKeyRef" }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "oauthMigrations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "secretKeyRef",
        "backoffLimit",
        "activeDeadlineSeconds",
        "serviceAccount",
        "podSecurityContext",
        "securityContext",
        "resources"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/$defs/image" },
        "secretKeyRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "key": { "type": "string" }
          }
        },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "serviceAccount": { "$ref": "#/$defs/serviceAccount" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "resources": { "type": "object" }
      }
    },
    "probe": {
      "type": "object",
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } },
      "additionalProperties": true
    },
    "hpa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "string" }] }
      }
    },
    "workloadProperties": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/$defs/image" },
        "replicas": { "type": "integer", "minimum": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "serviceAccount": { "$ref": "#/$defs/serviceAccount" },
        "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "resources": { "type": "object" },
        "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "affinity": { "type": "object" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "liveness": { "$ref": "#/$defs/probe" },
            "readiness": { "$ref": "#/$defs/probe" }
          }
        },
        "hpa": { "$ref": "#/$defs/hpa" },
        "pdb": { "$ref": "#/$defs/pdb" }
      }
    },
    "backend": {
      "allOf": [
        { "$ref": "#/$defs/workloadProperties" },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "env": {
              "type": "object",
              "additionalProperties": { "type": ["string", "number", "boolean"] }
            },
            "secretRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "name": { "type": "string" } }
            }
          }
        }
      ]
    },
    "authorizationBrokerStaticClient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientId", "redirectUris"],
      "properties": {
        "clientId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._~-]{8,200}$"
        },
        "redirectUris": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^(?:https://[^#]+|http://(?:localhost|[a-z0-9.-]+\\.localhost|127(?:\\.[0-9]{1,3}){3}|\\[::1\\])(?::[0-9]{1,5})?(?:/[^#]*)?(?:\\?[^#]*)?)$"
          }
        },
        "applicationType": { "enum": ["native", "web"] },
        "clientName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "clientUri": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://[^#]+$"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "authorizationBrokerDcr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "allowLoopbackRedirects",
        "trustedProxy",
        "clientTtlMs",
        "maxClients",
        "maxRateKeys",
        "rateLimit",
        "rateWindowMs"
      ],
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": false } }
          },
          "then": {
            "properties": {
              "allowLoopbackRedirects": { "const": false },
              "trustedProxy": {
                "properties": {
                  "header": { "maxLength": 0 },
                  "addresses": { "maxItems": 0 }
                }
              },
              "clientTtlMs": { "maximum": 0 },
              "maxClients": { "maximum": 0 },
              "maxRateKeys": { "maximum": 0 },
              "rateLimit": { "maximum": 0 },
              "rateWindowMs": { "maximum": 0 }
            }
          }
        }
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "allowLoopbackRedirects": { "type": "boolean" },
        "trustedProxy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["header", "addresses"],
          "allOf": [
            {
              "if": {
                "properties": {
                  "header": { "minLength": 1 }
                }
              },
              "then": {
                "properties": {
                  "header": { "pattern": "^[a-z0-9-]{1,64}$" },
                  "addresses": { "minItems": 1 }
                }
              },
              "else": {
                "properties": {
                  "addresses": { "maxItems": 0 }
                }
              }
            }
          ],
          "properties": {
            "header": { "type": "string" },
            "addresses": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 2, "maxLength": 64 }
            }
          }
        },
        "clientTtlMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "maxClients": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "maxRateKeys": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "rateLimit": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "rateWindowMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "authorizationBroker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "issuer",
        "resource",
        "googleCallbackUri",
        "activeSigningKid",
        "scopes",
        "staticClients",
        "signingKeyring",
        "ingressControllerPeer",
        "dcr"
      ],
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true } }
          },
          "then": {
            "properties": {
              "issuer": { "minLength": 1, "pattern": "^https://[^/?#]+(?:/[^?#]*)?$" },
              "resource": { "minLength": 1, "pattern": "^https://[^/?#]+(?:/[^?#]*)?$" },
              "googleCallbackUri": {
                "minLength": 1,
                "pattern": "^https://[^/?#]+(?:/[^?#]*)?$"
              },
              "activeSigningKid": { "minLength": 1 },
              "scopes": { "minItems": 1 },
              "signingKeyring": {
                "properties": {
                  "secretKeyRef": { "$ref": "#/$defs/secretKeyRef" }
                }
              },
              "ingressControllerPeer": {
                "properties": {
                  "namespaceSelector": {
                    "properties": { "matchLabels": { "minProperties": 1 } }
                  },
                  "podSelector": {
                    "properties": { "matchLabels": { "minProperties": 1 } }
                  }
                }
              }
            },
            "anyOf": [
              {
                "properties": {
                  "dcr": {
                    "properties": { "enabled": { "const": true } }
                  }
                }
              },
              {
                "properties": { "staticClients": { "minItems": 1 } }
              }
            ]
          },
          "else": {
            "properties": {
              "issuer": { "maxLength": 0 },
              "resource": { "maxLength": 0 },
              "googleCallbackUri": { "maxLength": 0 },
              "activeSigningKid": { "maxLength": 0 },
              "scopes": { "const": ["mcp"] },
              "staticClients": { "maxItems": 0 },
              "signingKeyring": {
                "properties": {
                  "secretKeyRef": { "$ref": "#/$defs/emptyKeyRef" }
                }
              },
              "ingressControllerPeer": {
                "properties": {
                  "namespaceSelector": {
                    "properties": { "matchLabels": { "maxProperties": 0 } }
                  },
                  "podSelector": {
                    "properties": { "matchLabels": { "maxProperties": 0 } }
                  }
                }
              },
              "dcr": {
                "properties": {
                  "enabled": { "const": false },
                  "allowLoopbackRedirects": { "const": false },
                  "trustedProxy": {
                    "properties": {
                      "header": { "maxLength": 0 },
                      "addresses": { "maxItems": 0 }
                    }
                  },
                  "clientTtlMs": { "maximum": 0 },
                  "maxClients": { "maximum": 0 },
                  "maxRateKeys": { "maximum": 0 },
                  "rateLimit": { "maximum": 0 },
                  "rateWindowMs": { "maximum": 0 }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "issuer": { "type": "string" },
        "resource": { "type": "string" },
        "googleCallbackUri": { "type": "string" },
        "activeSigningKid": { "type": "string", "maxLength": 256 },
        "scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "staticClients": {
          "type": "array",
          "items": { "$ref": "#/$defs/authorizationBrokerStaticClient" }
        },
        "signingKeyring": {
          "type": "object",
          "additionalProperties": false,
          "required": ["secretKeyRef"],
          "properties": {
            "secretKeyRef": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "key"],
              "properties": {
                "name": { "type": "string" },
                "key": { "type": "string", "pattern": "^(|[A-Za-z0-9._-]+)$" }
              }
            }
          }
        },
        "ingressControllerPeer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespaceSelector", "podSelector"],
          "properties": {
            "namespaceSelector": {
              "type": "object",
              "additionalProperties": false,
              "required": ["matchLabels"],
              "properties": {
                "matchLabels": {
                  "type": "object",
                  "additionalProperties": { "type": "string", "minLength": 1 },
                  "propertyNames": { "minLength": 1 }
                }
              }
            },
            "podSelector": {
              "type": "object",
              "additionalProperties": false,
              "required": ["matchLabels"],
              "properties": {
                "matchLabels": {
                  "type": "object",
                  "additionalProperties": { "type": "string", "minLength": 1 },
                  "propertyNames": { "minLength": 1 }
                }
              }
            }
          }
        },
        "dcr": { "$ref": "#/$defs/authorizationBrokerDcr" }
      }
    },
    "googleWorkspace": {
      "allOf": [
        { "$ref": "#/$defs/backend" },
        {
          "type": "object",
          "properties": {
            "authorizationBroker": { "$ref": "#/$defs/authorizationBroker" },
            "policy": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "mountPath": { "type": "string" },
                "yaml": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "agentgateway": {
      "allOf": [
        { "$ref": "#/$defs/workloadProperties" },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "service": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] } }
            },
            "backends": { "type": "array", "items": { "type": "object" } },
            "mcpAuthentication": { "type": "object" },
            "ingress": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "brokerAnnotations": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                },
                "paths": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "pattern": "^/" }
                }
              }
            }
          }
        }
      ]
    }
  }
}
