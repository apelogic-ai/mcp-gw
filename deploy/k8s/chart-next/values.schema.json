{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/apelogic-ai/mcp-gw/deploy/k8s/chart-next/values.schema.json",
  "title": "mcp-gateway Helm values",
  "description": "Shape and bounds only. Relationships between fields are not checked here because the templates derive them from one another: every public OAuth URL comes from routing.host, and the AgentGateway MCP targets come from the enabled provider components.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fullnameOverride": {"type": "string", "pattern": "^$|^[a-z]([a-z0-9-]*[a-z0-9])?$", "maxLength": 53},
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imagePullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {"name": {"type": "string"}}
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"name": {"type": "string"}}
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "pattern": "^$|[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$"
        },
        "mcpPath": {"type": "string", "pattern": "^/[A-Za-z0-9._~/-]*$"},
        "oauthPath": {"type": "string", "pattern": "^/[A-Za-z0-9._~/-]*$"},
        "gatewayApi": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "parentRefs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                  "group": {"type": "string"},
                  "kind": {"type": "string"},
                  "name": {"type": "string", "minLength": 1},
                  "namespace": {"type": "string"},
                  "sectionName": {"type": "string"},
                  "port": {"type": "integer"}
                }
              }
            }
          },
          "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
          "then": {"required": ["parentRefs"], "properties": {"parentRefs": {"minItems": 1}}}
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "className": {"type": "string"},
            "annotations": {
              "type": "object",
              "additionalProperties": {"type": ["string", "number", "boolean"]}
            },
            "brokerAnnotations": {
              "type": "object",
              "additionalProperties": {"type": ["string", "number", "boolean"]}
            },
            "tls": {"type": "array"}
          }
        }
      }
    },
    "hop1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"issuers": {"type": "array", "items": {"$ref": "#/$defs/hop1Issuer"}}}
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caBundle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "mountPath": {"type": "string", "pattern": "^/[A-Za-z0-9._~/-]*$", "minLength": 1},
            "configMapKeyRef": {"$ref": "#/$defs/keyRef"},
            "secretKeyRef": {"$ref": "#/$defs/keyRef"}
          },
          "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
          "then": {
            "oneOf": [
              {
                "properties": {
                  "configMapKeyRef": {
                    "required": ["name", "key"],
                    "properties": {"name": {"minLength": 1}, "key": {"minLength": 1}}
                  },
                  "secretKeyRef": {"properties": {"name": {"const": ""}, "key": {"const": ""}}}
                },
                "required": ["configMapKeyRef"]
              },
              {
                "properties": {
                  "secretKeyRef": {
                    "required": ["name", "key"],
                    "properties": {"name": {"minLength": 1}, "key": {"minLength": 1}}
                  },
                  "configMapKeyRef": {"properties": {"name": {"const": ""}, "key": {"const": ""}}}
                },
                "required": ["secretKeyRef"]
              }
            ]
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressSourceCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:[0-9]|[12][0-9]|3[0-2])|[0-9A-Fa-f:]+/(?:[0-9]|[1-9][0-9]|1[01][0-9]|12[0-8]))$",
            "not": {"enum": ["0.0.0.0/0", "::/0"]}
          }
        },
        "ingressControllerPeer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceSelector": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "matchLabels": {
                  "type": "object",
                  "additionalProperties": {"type": ["string", "number", "boolean"]}
                }
              }
            },
            "podSelector": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "matchLabels": {
                  "type": "object",
                  "additionalProperties": {"type": ["string", "number", "boolean"]}
                }
              }
            }
          }
        }
      },
      "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
      "then": {
        "oneOf": [
          {
            "properties": {"ingressSourceCidrs": {"minItems": 1}},
            "required": ["ingressSourceCidrs"]
          },
          {
            "properties": {
              "ingressControllerPeer": {
                "properties": {
                  "namespaceSelector": {
                    "properties": {"matchLabels": {"minProperties": 1}},
                    "required": ["matchLabels"]
                  },
                  "podSelector": {
                    "properties": {"matchLabels": {"minProperties": 1}},
                    "required": ["matchLabels"]
                  }
                },
                "required": ["namespaceSelector", "podSelector"]
              }
            },
            "required": ["ingressControllerPeer"]
          }
        ]
      }
    },
    "oauthMigrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/$defs/image"},
        "secretKeyRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key"],
          "properties": {"name": {"type": "string"}, "key": {"type": "string", "minLength": 1}}
        },
        "backoffLimit": {"type": "integer", "minimum": 0},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 1},
        "serviceAccount": {"$ref": "#/$defs/serviceAccount"},
        "podSecurityContext": {"type": "object"},
        "securityContext": {"type": "object"},
        "resources": {"type": "object"}
      },
      "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
      "then": {"required": ["image", "secretKeyRef"]}
    },
    "agentgateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/$defs/image"},
        "replicas": {"type": "integer", "minimum": 0},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "revisionHistoryLimit": {"type": "integer", "minimum": 0},
        "service": {"$ref": "#/$defs/service"},
        "serviceAccount": {"$ref": "#/$defs/serviceAccount"},
        "automountServiceAccountToken": {"type": "boolean"},
        "podAnnotations": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "podSecurityContext": {"type": "object"},
        "securityContext": {"type": "object"},
        "resources": {"type": "object"},
        "nodeSelector": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "affinity": {"type": "object"},
        "tolerations": {"type": "array"},
        "topologySpreadConstraints": {"type": "array"},
        "probes": {"$ref": "#/$defs/probes"},
        "hpa": {"$ref": "#/$defs/hpa"},
        "pdb": {"$ref": "#/$defs/pdb"},
        "failureMode": {"enum": ["failOpen", "failClosed"]},
        "cors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowOrigins": {"type": "array", "items": {"type": "string"}},
            "allowHeaders": {"type": "array", "items": {"type": "string"}},
            "exposeHeaders": {"type": "array", "items": {"type": "string"}}
          }
        },
        "mcpAuthentication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {"enum": ["strict", "permissive", "optional"]},
            "bearerMethodsSupported": {"type": "array", "items": {"type": "string"}},
            "scopesSupported": {
              "type": "array",
              "items": {"type": "string", "pattern": "^[\\x21\\x23-\\x2b\\x2d-\\x5b\\x5d-\\x7e]+$"}
            }
          }
        },
        "backendOverrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": {"type": "string"},
              "port": {"type": "integer"},
              "path": {"type": "string", "pattern": "^/[A-Za-z0-9._~/-]*$"}
            }
          }
        },
        "extraBackends": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "host"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "host": {"type": "string", "minLength": 1}
            }
          }
        }
      },
      "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
      "then": {"required": ["image"]}
    },
    "googleWorkspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/$defs/image"},
        "replicas": {"type": "integer", "minimum": 0},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "revisionHistoryLimit": {"type": "integer", "minimum": 0},
        "service": {"$ref": "#/$defs/service"},
        "serviceAccount": {"$ref": "#/$defs/serviceAccount"},
        "automountServiceAccountToken": {"type": "boolean"},
        "podAnnotations": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "podSecurityContext": {"type": "object"},
        "securityContext": {"type": "object"},
        "resources": {"type": "object"},
        "nodeSelector": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "affinity": {"type": "object"},
        "tolerations": {"type": "array"},
        "topologySpreadConstraints": {"type": "array"},
        "probes": {"$ref": "#/$defs/probes"},
        "hpa": {"$ref": "#/$defs/hpa"},
        "pdb": {"$ref": "#/$defs/pdb"},
        "env": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "secretRef": {"$ref": "#/$defs/secretRef"},
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "mountPath": {"type": "string", "pattern": "^/[A-Za-z0-9._~/-]*$"},
            "yaml": {"type": "string"}
          },
          "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
          "then": {"required": ["yaml"], "properties": {"yaml": {"minLength": 1}}}
        },
        "authorizationBroker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "activeSigningKid": {"type": "string"},
            "scopes": {
              "type": "array",
              "items": {"type": "string", "pattern": "^[\\x21\\x23-\\x2b\\x2d-\\x5b\\x5d-\\x7e]+$"}
            },
            "staticClients": {"type": "array", "items": {"$ref": "#/$defs/staticClient"}},
            "signingKeyring": {
              "type": "object",
              "additionalProperties": false,
              "properties": {"secretKeyRef": {"$ref": "#/$defs/keyRef"}}
            },
            "dcr": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "allowLoopbackRedirects": {"type": "boolean"},
                "trustedProxy": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "header": {"type": "string"},
                    "addresses": {"type": "array", "items": {"type": "string", "minLength": 1}}
                  }
                },
                "clientTtlMs": {"type": "integer", "minimum": 0},
                "maxClients": {"type": "integer", "minimum": 0},
                "maxRateKeys": {"type": "integer", "minimum": 0},
                "rateLimit": {"type": "integer", "minimum": 0},
                "rateWindowMs": {"type": "integer", "minimum": 0}
              }
            }
          },
          "allOf": [
            {
              "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
              "then": {
                "required": ["activeSigningKid", "scopes"],
                "properties": {"activeSigningKid": {"minLength": 1}, "scopes": {"minItems": 1}}
              }
            },
            {
              "if": {
                "properties": {
                  "enabled": {"const": true},
                  "dcr": {"properties": {"enabled": {"const": false}}}
                },
                "required": ["enabled"]
              },
              "then": {"properties": {"staticClients": {"minItems": 1}}}
            }
          ]
        }
      },
      "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
      "then": {"required": ["image"]}
    },
    "githubWrapper": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/$defs/image"},
        "replicas": {"type": "integer", "minimum": 0},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "revisionHistoryLimit": {"type": "integer", "minimum": 0},
        "service": {"$ref": "#/$defs/service"},
        "serviceAccount": {"$ref": "#/$defs/serviceAccount"},
        "automountServiceAccountToken": {"type": "boolean"},
        "podAnnotations": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "podSecurityContext": {"type": "object"},
        "securityContext": {"type": "object"},
        "resources": {"type": "object"},
        "nodeSelector": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "affinity": {"type": "object"},
        "tolerations": {"type": "array"},
        "topologySpreadConstraints": {"type": "array"},
        "probes": {"$ref": "#/$defs/probes"},
        "hpa": {"$ref": "#/$defs/hpa"},
        "pdb": {"$ref": "#/$defs/pdb"},
        "env": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "secretRef": {"$ref": "#/$defs/secretRef"}
      },
      "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
      "then": {"required": ["image"]}
    },
    "githubMcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/$defs/image"},
        "replicas": {"type": "integer", "minimum": 0},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "revisionHistoryLimit": {"type": "integer", "minimum": 0},
        "service": {"$ref": "#/$defs/service"},
        "serviceAccount": {"$ref": "#/$defs/serviceAccount"},
        "automountServiceAccountToken": {"type": "boolean"},
        "podAnnotations": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "podSecurityContext": {"type": "object"},
        "securityContext": {"type": "object"},
        "resources": {"type": "object"},
        "nodeSelector": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "affinity": {"type": "object"},
        "tolerations": {"type": "array"},
        "topologySpreadConstraints": {"type": "array"},
        "probes": {"$ref": "#/$defs/probes"},
        "hpa": {"$ref": "#/$defs/hpa"},
        "pdb": {"$ref": "#/$defs/pdb"},
        "env": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}}
      },
      "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
      "then": {"required": ["image"]}
    },
    "dbMcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/$defs/image"},
        "replicas": {"type": "integer", "minimum": 0},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "revisionHistoryLimit": {"type": "integer", "minimum": 0},
        "service": {"$ref": "#/$defs/service"},
        "serviceAccount": {"$ref": "#/$defs/serviceAccount"},
        "automountServiceAccountToken": {"type": "boolean"},
        "podAnnotations": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "podSecurityContext": {"type": "object"},
        "securityContext": {"type": "object"},
        "resources": {"type": "object"},
        "nodeSelector": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "affinity": {"type": "object"},
        "tolerations": {"type": "array"},
        "topologySpreadConstraints": {"type": "array"},
        "probes": {"$ref": "#/$defs/probes"},
        "hpa": {"$ref": "#/$defs/hpa"},
        "pdb": {"$ref": "#/$defs/pdb"},
        "env": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "secretRef": {"$ref": "#/$defs/secretRef"}
      },
      "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
      "then": {"required": ["image"]}
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$"}
      }
    },
    "probe": {"type": "object", "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}},
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"liveness": {"$ref": "#/$defs/probe"}, "readiness": {"$ref": "#/$defs/probe"}}
    },
    "hpa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "minReplicas": {"type": "integer", "minimum": 1},
        "maxReplicas": {"type": "integer", "minimum": 1},
        "targetCPUUtilizationPercentage": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"enabled": {"type": "boolean"}, "minAvailable": {"type": ["integer", "string"]}}
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {"type": "boolean"},
        "annotations": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "name": {"type": "string"}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]}}
    },
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"name": {"type": "string"}}
    },
    "keyRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"name": {"type": "string"}, "key": {"type": "string"}}
    },
    "hop1Issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "issuer", "jwksUrl", "audiences", "allowedAlgorithms"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "issuer": {"type": "string", "pattern": "^https://"},
        "jwksUrl": {"type": "string", "pattern": "^https?://"},
        "audiences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "allowedAlgorithms": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "emailClaim": {"type": "string"},
        "subjectClaim": {"type": "string"},
        "clientId": {"type": "string"},
        "discoverable": {"type": "boolean"},
        "introspection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "credentialSecretKeyRef"],
          "properties": {
            "url": {"type": "string", "pattern": "^https://"},
            "credentialSecretKeyRef": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "key"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "key": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "staticClient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientId", "redirectUris"],
      "properties": {
        "clientId": {"type": "string", "pattern": "^[A-Za-z0-9._~-]{8,200}$"},
        "redirectUris": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^(https://|http://(localhost|127\\.|\\[::1\\]))"}
        },
        "scopes": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[\\x21\\x23-\\x2b\\x2d-\\x5b\\x5d-\\x7e]+$"}
        },
        "clientName": {"type": "string"},
        "clientUri": {"type": "string", "pattern": "^https://"}
      }
    }
  }
}
